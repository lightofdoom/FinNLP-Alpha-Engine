# Copy to .env and fill in values. Never commit .env.

FINNHUB_API_KEY=

# Alpaca paper keys from https://app.alpaca.markets/paper/dashboard/overview
APCA_API_KEY_ID=
APCA_API_SECRET_KEY=
APCA_API_BASE_URL=https://paper-api.alpaca.markets

# iex is the only real-time feed on the free plan. sip is historical-only if end is >= 15 minutes ago.
ALPACA_DATA_FEED=iex

# Must be true to use the live trading host. Leave false.
ALPACA_ALLOW_LIVE=false

ALPACA_MAX_SYMBOLS=30
ALPACA_REST_PER_MIN=180
ALPACA_NOTIONAL=1000
ALPACA_LIMIT_OFFSET_BPS=5
ALPACA_MAX_ORDERS_PER_DAY=10
ALPACA_MAX_LOSS_DOLLARS=2000

OPENAI_API_KEY=
